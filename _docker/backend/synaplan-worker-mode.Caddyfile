# =============================================================================
# synaplan :: FrankenPHP worker-mode Caddy snippet (PROD)
# -----------------------------------------------------------------------------
# Imported from the global options of _docker/backend/Caddyfile. The base
# image's shim copies this file into place for APP_ENV=prod and writes a
# classic-mode stub otherwise.
#
# The pools themselves are not here. `match` is only legal inside a
# php_server worker, and two global workers cannot share one filename, so
# synaplan-php-workers.Caddyfile is imported from the site's php_server.
# This block only sets how long a request waits for a free worker.
#
# Nested Caddy defaults do not parse, and an empty num_threads is a parse
# error. docker-entrypoint.sh exports FRANKENPHP_STREAM_WORKER_NUM from
# FRANKENPHP_WORKER_NUM when it is unset, and inserts num_threads /
# max_threads only when those variables are set.
# =============================================================================

frankenphp {
	max_wait_time {$FRANKENPHP_MAX_WAIT_TIME:15s}
}

# Optional. Save as .env next to compose.yaml (or load it in your Docker GUI).
# Every line may stay empty: Synaplan then starts on http://127.0.0.1:8000.

# Release to run. Empty = the release this compose.yaml ships with.
# Older and newer tags: https://github.com/metadist/synaplan/releases
# Back up the volumes before you change it.
SYNAPLAN_VERSION=

# Where the app listens. 127.0.0.1 = this machine only.
# For other computers on your network: SYNAPLAN_HTTP_BIND=0.0.0.0 and
# SYNAPLAN_URL=http://<this machine's IP>:8000
SYNAPLAN_HTTP_BIND=
SYNAPLAN_HTTP_PORT=
# The address people type into the browser. Live chat stays disconnected when
# it does not match. Default: http://127.0.0.1:<SYNAPLAN_HTTP_PORT>
SYNAPLAN_URL=

# AI provider keys. You can also add them later in the app (Admin > AI Providers).
# Free key: https://console.groq.com
AI_DEFAULT_PROVIDER=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# First administrator. Leave both empty and create it in the browser at /setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Empty = managed in the app. "false" switches it off and locks the toggle.
REGISTRATION_ENABLED=
GUEST_CHAT_ENABLED=

# Outgoing email (password reset, invitations). Empty = no email is sent.
# Example: smtp://user:password@smtp.example.com:587
MAILER_DSN=
APP_SENDER_EMAIL=

[Unit]
Description=Synaplan application stack
Documentation=https://github.com/metadist/synaplan/blob/main/deploy/aws/README.md
After=docker.service synaplan-firstboot.service
Requires=docker.service synaplan-firstboot.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/synaplan/deploy
# run.sh is the portable start command every platform adapter uses: it resolves
# the deployment secrets, validates the pinned release, and brings the stack up.
# The AWS adapter must not reimplement any of that.
ExecStart=/opt/synaplan/deploy/scripts/run.sh
ExecStop=/opt/synaplan/deploy/aws/scripts/stop.sh
# The first start pulls nothing (the images are baked in) but does run database
# migrations and waits for six services to become healthy.
TimeoutStartSec=1800
TimeoutStopSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

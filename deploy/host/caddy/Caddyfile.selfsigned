# TLS with a self-signed certificate.
#
# Used when the instance has no domain name. The browser shows a warning, which
# is correct and unavoidable: a certificate for a bare IP address cannot be
# verified by anyone. It is still the right default — the alternative is sending
# the administrator password over plain HTTP.
#
# Give the instance a domain and re-run `sudo synaplan-tls <domain>` to replace
# this with a publicly trusted certificate.

{
	# Caddy's internal CA. No ACME request is attempted, so this works in a VPC
	# with no outbound internet access at all.
	auto_https disable_redirects
}

:443 {
	tls internal

	encode zstd gzip

	reverse_proxy 127.0.0.1:8000 {
		# Chat responses stream token by token; buffering them would make the
		# assistant appear to answer all at once, minutes late.
		flush_interval -1
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/synaplan.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Anything arriving on plain HTTP goes to HTTPS. Without a domain Caddy cannot
# redirect by name, so this is a bare redirect to the host the client used.
:80 {
	redir https://{host}{uri} permanent
}

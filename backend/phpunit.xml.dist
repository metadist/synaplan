<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="false"
         failOnNotice="false"
         failOnWarning="false"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <env name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="weak" />
        <!-- force="true" wherever the dev container's environment differs from CI:
             real env vars beat values without it, so the local suite would send
             mail, call paid AI APIs with the developer's keys and see live sidecars. -->
        <env name="MAILER_DSN" value="null://null" force="true" />
        <env name="AI_DEFAULT_PROVIDER" value="test" force="true" />
        <env name="LOG_LEVEL" value="error" force="true" />
        <!-- Docker/backend/.env may set flock:///var/www/uploads (not writable for www-data under bind mounts). -->
        <env name="LOCK_DSN" value="flock:///tmp" force="true" />
        <!-- AI Provider API Keys (defaults for testing) -->
        <env name="ANTHROPIC_API_KEY" value="" force="true" />
        <env name="OPENAI_API_KEY" value="" force="true" />
        <env name="GROQ_API_KEY" value="" force="true" />
        <env name="GOOGLE_GEMINI_API_KEY" value="" force="true" />
        <env name="XAI_API_KEY" value="" force="true" />
        <!-- Brave Search API (defaults for testing) -->
        <env name="BRAVE_SEARCH_API_KEY" value="" force="true" />
        <env name="BRAVE_SEARCH_API_URL" value="https://api.search.brave.com/res/v1" />
        <env name="BRAVE_SEARCH_ENABLED" value="false" force="true" />
        <env name="BRAVE_SEARCH_COUNT" value="10" />
        <env name="BRAVE_SEARCH_COUNTRY" value="us" />
        <env name="BRAVE_SEARCH_SEARCH_LANG" value="en" />
        <!-- Qdrant (defaults for testing — empty = disabled) -->
        <env name="QDRANT_URL" value="" force="true" />
        <!-- Compose wires the compute sidecar and pins the feature on; CI has neither.
             Empty FEATURE_* means "not pinned", so BCONFIG decides as in CI. -->
        <env name="COMPUTE_URL" value="" force="true" />
        <env name="FEATURE_COMPUTE_ENABLED" value="" force="true" />
        <env name="FEATURE_COMPUTE_WORKSPACES_ENABLED" value="" force="true" />
        <!-- Stripe / Billing (force valid-looking keys so BillingService::isEnabled()=true in tests) -->
        <env name="STRIPE_SECRET_KEY" value="sk_test_fakeKeyForTestSuite000000000000" force="true" />
        <!-- Must match StripeWebhookControllerTest + StripeSignatureHelper; Docker/backend/.env must not win -->
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_fakeWebhookSecretForTests" force="true" />
        <env name="STRIPE_PRICE_PRO" value="price_1TestSuitePro" force="true" />
        <env name="STRIPE_PRICE_TEAM" value="price_1TestSuiteTeam" force="true" />
        <env name="STRIPE_PRICE_BUSINESS" value="price_1TestSuiteBusiness" force="true" />
        <!-- Force the SEPA-enabled allowlist so a developer's local .env can't suppress it. -->
        <env name="STRIPE_PAYMENT_METHODS" value="card,link,sepa_debit,klarna" force="true" />
        <!-- Whisper / TTS (defaults for testing) -->
        <env name="WHISPER_BINARY" value="/usr/local/bin/whisper" />
        <env name="WHISPER_MODELS_PATH" value="/tmp/whisper-models" />
        <env name="WHISPER_DEFAULT_MODEL" value="base" />
        <env name="WHISPER_ENABLED" value="false" force="true" />
        <env name="FFMPEG_BINARY" value="/usr/bin/ffmpeg" />
        <env name="SYNAPLAN_TTS_URL" value="" force="true" />
        <!-- Office engine off in tests. Docker compose sets OFFICE_CONVERT_URL
             when the Collabora sidecar is up; without force=true, kernel tests
             (runtime config, sorter snapshots) would see the live engine. -->
        <env name="OFFICE_CONVERT_URL" value="" force="true" />
        <!-- Compose injects SEARXNG_BASE_URL=http://searxng:8080. Admin status
             now live-probes that sidecar; keep the suite off the network. -->
        <env name="SEARXNG_BASE_URL" value="" force="true" />
        <server name="OFFICE_CONVERT_URL" value="" force="true" />
        <env name="OFFICE_CONVERT_TIMEOUT_MS" value="60000" force="true" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
            <exclude>tests/AI/Contract/ChatProviderContractTest.php</exclude>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>live-api</group>
        </exclude>
    </groups>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
        <bootstrap class="DG\BypassFinals\PHPUnitExtension"/>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>

    <logging>
        <testdoxHtml outputFile="var/phpunit/testdox.html"/>
        <junit outputFile="var/phpunit/junit.xml"/>
    </logging>
</phpunit>

includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - tests
        - lib/grpc
        - /plugins
    excludePaths:
        - src/Kernel.php
        - tests/Unit/CookieTokenAuthenticatorTest.php
        - /plugins/*/frontend
        - /plugins/*/frontend/*
        - /plugins/*/frontend/*/*
        - /plugins/*/migrations
        - /plugins/*/migrations/*
        - /plugins/*/backend/tests
        - /plugins/*/backend/tests/*
    # Doctrine discovers migrations by path, so they are neither autoloaded nor
    # analysed. Scanning makes the classes known to tests that execute a
    # migration's SQL, without pulling the migrations themselves into level 5.
    scanDirectories:
        - migrations
    ignoreErrors:
        -
            identifiers:
                - if.alwaysFalse
                - varTag.misplaced
                - unset.possiblyHookedProperty
            path: lib/grpc/*
        -
            identifiers:
                - method.alreadyNarrowedType
            path: tests/*
            reportUnmatched: false
        # synaform's controller is one pre-gate class. Its level-5 findings are
        # phpdoc narrowing inside that monolith; they wait for a split, not a
        # drive-by edit of a ten-thousand-line file.
        -
            message: '#.*#'
            path: /plugins/synaform/*
            reportUnmatched: false
        -
            identifiers:
                - property.unresolvableNativeType
                - property.unresolvableType
            path: tests/*
            reportUnmatched: false
    reportUnmatchedIgnoredErrors: false
    doctrine:
        objectManagerLoader: tests/object-manager.php


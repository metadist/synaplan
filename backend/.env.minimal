# Overlay for the Intermezzo S4 "minimal" CI lane.
# Loaded after .env.test so every optional feature module is absent.
# Real process environment wins over this file; phpunit.xml.dist `force="true"`
# still pins Stripe keys inside PHPUnit (BillingService tests). The console
# command `app:modules:list --assert-none-configured` is not PHPUnit and must
# see these empties. Keep in sync with docker-compose.minimal.yml — the
# architecture test fails if a decisive key is missing from either file.
#
# WHATSAPP_ENABLED is a bool env: false, not empty.
# FEATURE_MODULES_GATE_* pins every gate ON so an absent module's routes 404.

TIKA_BASE_URL=
TIKA_URL=
DOCLING_BASE_URL=
OFFICE_CONVERT_URL=
SEARXNG_BASE_URL=
SYNAPLAN_TTS_URL=
OLLAMA_BASE_URL=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
THEHIVE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
IAP_PRODUCT_PRO=
IAP_PRODUCT_TEAM=
IAP_PRODUCT_BUSINESS=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
COMPUTE_URL=
COMPUTE_TOKEN=

FEATURE_MODULES_GATE_TIKA=true
FEATURE_MODULES_GATE_DOCLING=true
FEATURE_MODULES_GATE_OFFICE_CONVERT=true
FEATURE_MODULES_GATE_SEARXNG=true
FEATURE_MODULES_GATE_PIPER_TTS=true
FEATURE_MODULES_GATE_LOCAL_AI=true
FEATURE_MODULES_GATE_HIGGSFIELD=true
FEATURE_MODULES_GATE_GOOGLE_AI=true
FEATURE_MODULES_GATE_THEHIVE=true
FEATURE_MODULES_GATE_STRIPE_BILLING=true
FEATURE_MODULES_GATE_MOBILE_IAP=true
FEATURE_MODULES_GATE_WHATSAPP=true
FEATURE_MODULES_GATE_COMPUTE=true

{
  "gateway": [
    {"method": "POST", "path": "/v1/chat/completions"},
    {"method": "POST", "path": "/v1/embeddings"},
    {"method": "POST", "path": "/v1/images/generations"},
    {"method": "GET", "path": "/v1/models"}
  ],
  "free": [
    {"method": "POST", "path": "/v1/free/keys", "auth": "public"},
    {"method": "GET", "path": "/v1/free/status", "auth": "freeapi key"},
    {"method": "DELETE", "path": "/v1/free/keys/self", "auth": "freeapi key"}
  ],
  "ops": "/api/v1/user/{accountId}/plugins/synafreeapi_server/",
  "scope": "freeapi",
  "denied_examples": [
    "/api/v1/messages",
    "/mcp",
    "/v1/messages",
    "/v1/media/generations",
    "/v1/audio/transcriptions",
    "/v1/audio/speech",
    "/v1/assistants"
  ]
}

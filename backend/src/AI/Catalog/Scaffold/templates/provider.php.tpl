<?php

declare(strict_types=1);

namespace App\AI\Provider;

use App\AI\Catalog\Attribute\AsAiProvider;
use App\AI\Catalog\ModelListing;
use App\AI\Catalog\ProviderBranding;
use App\AI\Catalog\ProviderCapability;
use App\AI\Catalog\ProviderDefaults;
use App\AI\Catalog\ProviderDescriptor;
use App\AI\Catalog\ProviderDialects;
use App\AI\Catalog\ProviderEndpoint;
use App\AI\Catalog\ProviderKeyPresentation;
use App\AI\Catalog\ProviderKeySpec;
use App\AI\Catalog\ProviderKeyValidation;
use App\AI\Catalog\ProviderPricing;
use App\AI\StructuredOutput\StructuredOutputDialect;

/**
 * {{displayName}} — OpenAI-compatible chat completions at {{baseUri}}.
 *
 * Generated by `app:provider:scaffold`. The descriptor below is the only
 * place this provider is declared: keys, defaults, upstreams, the admin
 * schema, the public catalog and the egress allowlist read it. Add the
 * model rows to `ModelCatalog` and the help sentence to the five locale
 * files, then `make ci-local`.
 */
#[AsAiProvider]
class {{class}} extends AbstractChatCompletionsCloudProvider
{
    private const PROVIDER_NAME = '{{name}}';
    private const BASE_URI = '{{baseUri}}';
    private const DEFAULT_CHAT_MODEL = '{{defaultModel}}';

    public static function descriptor(): ProviderDescriptor
    {
        return new ProviderDescriptor(
            name: self::PROVIDER_NAME,
            displayName: {{displayNameLiteral}},
            capabilities: [ProviderCapability::Chat],
            endpoints: [ProviderEndpoint::chatCompletions(self::BASE_URI.'/chat/completions')],
            key: ProviderKeySpec::platform(
                envVar: '{{envVar}}',
                consoleUrl: '{{consoleUrl}}',
                validation: ProviderKeyValidation::bearer(self::BASE_URI.'/models'),
                listOrder: 50,
                modelListing: ModelListing::Lists,
                fieldDescription: {{fieldDescriptionLiteral}},
                configSection: ProviderKeyPresentation::SECTION_CLOUD,
                configOrder: 50,
            ),
            dialects: new ProviderDialects(
                structuredOutput: StructuredOutputDialect::OPENAI_JSON_SCHEMA,
                catalogToolUse: true,
            ),
            // The models Admin → AI keys → "Use as default" binds; the keys
            // are `service:providerId:tag` rows of ModelCatalog.
            defaults: new ProviderDefaults(bindings: [
                'CHAT' => self::PROVIDER_NAME.':'.self::DEFAULT_CHAT_MODEL.':chat',
                'SORT' => self::PROVIDER_NAME.':'.self::DEFAULT_CHAT_MODEL.':chat',
                'SUMMARIZE' => self::PROVIDER_NAME.':'.self::DEFAULT_CHAT_MODEL.':chat',
            ], preferenceRank: 50),
            pricing: ProviderPricing::byServiceName(),
            liveVoiceSessions: null,
            branding: new ProviderBranding(icon: 'mdi:robot-outline', flag: '{{flag}}', helpKey: self::PROVIDER_NAME),
        );
    }

    public function getName(): string
    {
        return self::PROVIDER_NAME;
    }

    public function getDisplayName(): string
    {
        return {{displayNameLiteral}};
    }

    public function getDescription(): string
    {
        return {{descriptionLiteral}};
    }

    public function getCapabilities(): array
    {
        return ['chat'];
    }

    public function getDefaultModels(): array
    {
        return ['chat' => self::DEFAULT_CHAT_MODEL];
    }

    protected function baseUri(): string
    {
        return self::BASE_URI;
    }

    protected function envVarName(): string
    {
        return '{{envVar}}';
    }

    protected function envVarHint(): string
    {
        return {{hintLiteral}};
    }
}


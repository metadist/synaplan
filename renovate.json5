{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'docker:enableMajor',
    ':separateMultipleMajorReleases',
  ],
  enabled: true,
  timezone: 'Europe/Berlin',
  // npm 12 refuses registry tarballs of packages that declare
  // bundleDependencies during --package-lock-only (npm/cli#9800), and
  // @tailwindcss/oxide-wasm32-wasi in the frontend tree is one of them.
  // allow-remote=all is npm 11's default; allow-git stays at npm 12's "none".
  // Renovate writes this npmrc only for its own npm runs, so CI and local
  // installs keep npm's defaults. npmrcMerge keeps a future repo .npmrc.
  npmrc: 'allow-remote=all',
  npmrcMerge: true,
  constraints: {
    npm: '<13',
  },
  prHourlyLimit: 2,
  prConcurrentLimit: 10,
  prCreation: 'immediate',
  dependencyDashboard: {
    enabled: true,
  },
  labels: [
    'dependencies',
  ],
  ignorePaths: [
    '_devextras/mail-handler-test/**',
  ],
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
  },
  packageRules: [
    {
      description: 'Stability gate: let fresh releases prove themselves before we open a PR (supply-chain + broken-release protection). Security fixes bypass this.',
      matchDatasources: [
        '*',
      ],
      minimumReleaseAge: '3 days',
      minimumReleaseAgeBehaviour: 'timestamp-optional',
      internalChecksFilter: 'strict',
    },
    {
      description: 'Catch-all composer patch/minor FIRST — later rules override groupName for Framework/QA',
      groupName: 'Backend Dependencies',
      matchManagers: [
        'composer',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'Framework updates isolated — historically broke CI (#669)',
      groupName: 'PHP Framework',
      matchManagers: [
        'composer',
      ],
      matchPackageNames: [
        'symfony/**',
        'doctrine/**',
        'api-platform/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'Catch-all npm patch/minor — later rules override for Frontend Core and QA',
      groupName: 'Frontend Dependencies',
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'Frontend core frameworks grouped separately',
      groupName: 'Frontend Core',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'vue',
        'vue-router',
        'vue-i18n',
        'pinia',
        '@vue/**',
        'vite',
        '@vitejs/**',
        'typescript',
        '@typescript-eslint/**',
        'vue-tsc',
        'tailwindcss',
        '@tailwindcss/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'QA tools isolated — MUST come after npm catch-all so groupName wins (#580)',
      groupName: 'QA & Dev Tools',
      matchPackageNames: [
        'phpunit/phpunit',
        'phpstan/phpstan',
        'phpstan/phpstan-doctrine',
        'friendsofphp/php-cs-fixer',
        'dg/bypass-finals',
        '@playwright/test',
        'vitest',
        '@vitest/**',
        'happy-dom',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'Go sidecar dependencies grouped — `gomod` matched no group rule, so every update opened its own PR',
      groupName: 'Go Sidecar Dependencies',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'Docker image updates grouped',
      groupName: 'Docker Images',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: 'Docker digest bumps grouped -- no changelog exists, review is tag-based',
      groupName: 'Docker Digests',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
    },
    {
      description: 'Digests of our own images kept out of the third-party batch',
      groupName: 'Synaplan Image Digests',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      matchPackageNames: [
        'ghcr.io/metadist/**',
      ],
    },
    {
      description: 'GitHub Actions digest bumps grouped -- no changelog, CI is the review',
      groupName: 'GitHub Actions Digests',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
    },
    {
      description: 'Major updates: always individual, manual review',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'dependencies',
        'breaking',
      ],
    },
    {
      description: 'Hold vue-router on v4: v5 ships its file-routing build plugin (unplugin, picomatch, vite) as runtime dependencies, and picomatch <= 4.0.7 (GHSA-fc5q-39xc-vjpf) has no patched release, so v5 fails the production npm audit. Lift this once a patched picomatch is out.',
      matchPackageNames: [
        'vue-router',
      ],
      allowedVersions: '<5',
    },
  ],
}

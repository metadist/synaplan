# Meeting notes — copy to the environment of the transcriber container.
# OpenDesk operators: the same names are in helm/opendesk-values.example.yaml.

# jitsi | element | opendesk (Jitsi meetings and Element voice messages)
TRANSCRIBER_MODE=opendesk
TRANSCRIBER_HOST=0.0.0.0
TRANSCRIBER_PORT=8095
# Shared secret Jicofo sends as Authorization: Bearer. Empty allows the socket.
TRANSCRIBER_AUTH_TOKEN=
# auto | de | en | es | fr | tr
TRANSCRIBER_LANGUAGE=auto
# Window length before a caption is requested. Audio is discarded after it.
COMMIT_AFTER_MS=8000

# Synaplan. The key should carry only the audio:transcribe scope.
SYNAPLAN_URL=https://synaplan.example
SYNAPLAN_API_KEY=
# Empty uses the installation's default speech-to-text model (local whisper on sovereign installs).
SYNAPLAN_STT_MODEL=
NOTES_SAVE_TO_SYNAPLAN=true

# Element / Matrix. Required for voice messages and for the end-of-meeting line.
MATRIX_HOMESERVER=https://matrix.example
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=@synaplan-notes:example
# Optional room that receives "Notes from 10:00 — open in Files".
NOTES_MATRIX_ROOM=

# Nextcloud Files. App password, not the user's login password.
NEXTCLOUD_URL=https://files.example
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NOTES_NEXTCLOUD_FOLDER=/Meetings

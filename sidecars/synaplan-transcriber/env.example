# Meeting notes — copy to the environment of the transcriber container.
# One process runs one TRANSCRIBER_MODE. The operator guide is
# docs/OPENDESK_MEETING_NOTES.md. OpenTalk is docs/OPENTALK_MEETING_NOTES.md.
#
# jitsi     plugin meeting notes (the openDesk chart), or captions without the plugin
# element   Element voice messages (older path)
# opendesk  jitsi and element together. Compose defaults to this. Older path
# opentalk  OpenTalk 26.3 subtitles. A second process, not the chart
TRANSCRIBER_MODE=opendesk
TRANSCRIBER_HOST=0.0.0.0
TRANSCRIBER_PORT=8095
# Required for jitsi and opendesk. Jicofo sends it as Authorization: Bearer.
# It is not accepted in the WebSocket URL.
TRANSCRIBER_AUTH_TOKEN=
# auto | de | en | es | fr | tr
TRANSCRIBER_LANGUAGE=auto
# Window length before a caption is requested. Audio is discarded after it.
COMMIT_AFTER_MS=8000
# Live caption preview while someone is still talking, in ms. 0 sends one caption per window.
PREVIEW_EVERY_MS=1500

# Synaplan. The plugin needs SYNAPLAN_TRANSCRIBER_SECRET, the same value as the
# plugin setting transcriber_secret. SYNAPLAN_API_KEY is the older path
# (Element voice messages, Jitsi captions without the plugin) and needs only
# the audio:transcribe scope. At least one of the two is required.
SYNAPLAN_URL=https://synaplan.example
SYNAPLAN_TRANSCRIBER_SECRET=
SYNAPLAN_API_KEY=
# Empty uses the installation's default speech-to-text model. The plugin has
# its own speech server (stt_url) and does not read this.
SYNAPLAN_STT_MODEL=
NOTES_SAVE_TO_SYNAPLAN=true

# OpenTalk. Required together when TRANSCRIBER_MODE=opentalk, ignored otherwise.
# Both keys are id:secret. OPENTALK_INIT_KEY is the controller's api_key.
# OPENTALK_LIVEKIT_URL is required: the process does not start without it.
OPENTALK_CONTROLLER_URL=
OPENTALK_SERVICE_KEY=
OPENTALK_INIT_KEY=
OPENTALK_LIVEKIT_URL=

# Element / Matrix. Required for voice messages and for the end-of-meeting line.
MATRIX_HOMESERVER=https://matrix.example
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=@synaplan-notes:example
# Optional room that receives "Notes from 10:00 — open in Files".
NOTES_MATRIX_ROOM=

# Nextcloud Files, older path only. App password, not the user's login password.
NEXTCLOUD_URL=https://files.example
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NOTES_NEXTCLOUD_FOLDER=/Meetings

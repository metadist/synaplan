# Copy the shared secret into the Synaplan backend env as well.
# Provider keys are read from the environment. Never put them in the ticket.

PORT=8096
SYNAPLAN_URL=http://backend
LIVE_VOICE_GATEWAY_SECRET=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_LIVE_REGION=us
# Optional overrides. Empty uses the public provider endpoint.
# OPENAI_LIVE_URL=
# OPENAI_REALTIME_URL=
# GEMINI_LIVE_URL=
# XAI_REALTIME_URL=
LIVE_VOICE_ALLOWED_ORIGINS=
TICK_SECONDS=15
IDLE_SECONDS=120

COMPUTE_AUTH_TOKEN=
COMPUTE_LISTEN=:8080
COMPUTE_SCRATCH_DIR=/var/lib/synaplan-compute/scratch
COMPUTE_WORKSPACES_DIR=/var/lib/synaplan-compute/workspaces
COMPUTE_TIER=
# uid:gid the sandbox runs as. Scratch is chowned to <uid>:<service-gid> so the
# service can still list /out; without CAP_CHOWN it falls back to 0777/0666.
COMPUTE_SANDBOX_UID=65534
COMPUTE_SANDBOX_GID=65534
COMPUTE_MAX_CONCURRENT=8
COMPUTE_QUEUE_MAX=16
COMPUTE_RUN_RETENTION_MIN=60
COMPUTE_MAX_REQUEST_BYTES=33554432
COMPUTE_MAX_FILES=32
# Egress (CP22): per-run proxy on a private network, pinned public IPs only.
# Empty allow-lists keep NetworkMode none regardless of this flag.
COMPUTE_EGRESS_ENABLED=false
# Proxy container image. Empty resolves the sidecar's own image.
COMPUTE_PROXY_IMAGE=

{
  "schemaVersion": 1,
  "classifications": [
    "no-app-impact",
    "backend-only",
    "ota-candidate",
    "store-required"
  ],
  "labels": {
    "no-app-impact": "mobile-impact:no-app-impact",
    "backend-only": "mobile-impact:backend-only",
    "ota-candidate": "mobile-impact:ota-candidate",
    "store-required": "mobile-impact:store-required",
    "otaApproval": "mobile-ota-approved"
  },
  "storeRequired": {
    "reason": "The change affects a native binary, in-app purchases or payments, authentication transport, a native seam, forced-update logic, or the update mechanism itself, so it must ship through a store review.",
    "patterns": [
      "android/**",
      "ios/**",
      "capacitor.config.*",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "**/*MobileVersion*",
      "frontend/src/**/auth/**",
      "frontend/src/**/*Iap*",
      "frontend/src/**/*IAP*",
      "frontend/src/**/iap*",
      "frontend/src/**/*Subscription*",
      "frontend/src/**/subscription*",
      "frontend/src/**/subscription/**",
      "frontend/src/**/*Payment*",
      "frontend/src/**/payment*",
      "frontend/src/**/*Purchase*",
      "frontend/src/**/purchase*",
      "frontend/src/**/*Stripe*",
      "frontend/src/**/stripe*",
      "frontend/src/**/*Paywall*",
      "frontend/src/**/paywall*",
      "frontend/src/**/*RuntimeConfig*",
      "frontend/src/**/*Biometric*",
      "frontend/src/**/*Native*",
      "frontend/src/stores/auth.ts",
      "frontend/src/stores/config.ts",
      "frontend/src/composables/useAuth.ts",
      "frontend/src/composables/useSocialAuth.ts",
      "frontend/src/composables/useBiometricLock.ts",
      "frontend/src/utils/pendingAuthRedirect.ts",
      "frontend/src/services/authService.ts",
      "frontend/src/services/biometricLock.ts",
      "frontend/src/services/native*.ts",
      "frontend/src/services/otaUpdates.ts",
      "frontend/src/services/api/authApi.ts",
      "frontend/src/services/api/native*.ts",
      "frontend/**/sw.js",
      "frontend/**/*ServiceWorker*",
      "frontend/**/*serviceWorker*",
      "frontend/public/site.webmanifest"
    ]
  },
  "otaCandidate": {
    "reason": "The change is limited to the web layer delivered inside the app bundle (Vue/TypeScript application code, styling, translations, static assets, or web build configuration), which Apple ADPLA 3.3.2 and Google Play permit over the air because it runs in the system WebView.",
    "patterns": [
      "frontend/src/**",
      "frontend/public/**",
      "frontend/index.html",
      "frontend/package.json",
      "frontend/package-lock.json",
      "frontend/pnpm-lock.yaml",
      "frontend/yarn.lock",
      "frontend/vite.config*.ts",
      "frontend/tsconfig*.json",
      "frontend/postcss.config.js",
      "frontend/tailwind.config.js",
      "frontend/schema-template.hbs",
      "frontend/scripts/**"
    ]
  },
  "backendOnly": {
    "reason": "The change only touches server-side code, configuration, or server-delivered plugins. Nothing of it ships inside the app binary or the bundled web assets, so no app delivery is required.",
    "patterns": [
      "backend/**",
      "plugins/**"
    ],
    "excludedPatterns": []
  },
  "noAppImpact": {
    "reason": "The change only affects documentation, local development and container tooling, deployment configuration, test suites, continuous integration, or release tooling, none of which is delivered to an installed app.",
    "patterns": [
      "**/*.md",
      "docs/**",
      "deploy/**",
      "cloudflare/**",
      "_devextras/**",
      "_docker/**",
      "_1st_install_linux.sh",
      "docker-compose*.yml",
      "elestio.yml",
      "server.json",
      "renovate.json5",
      "LICENSE",
      "**/Makefile",
      ".editorconfig",
      ".gitignore",
      ".gitattributes",
      ".nvmrc",
      ".dockerignore",
      ".cursorindexingignore",
      ".git-blame-ignore-revs",
      ".vscode/**",
      ".github/**",
      "scripts/**",
      "tests/**",
      "frontend/tests/**",
      "frontend/test-results/**",
      "frontend/dist-widget/**",
      "frontend/.env.example",
      "frontend/.gitignore",
      "frontend/.prettierrc",
      "frontend/.prettierignore",
      "frontend/eslint.config.js"
    ]
  },
  "fallback": {
    "classification": "store-required",
    "reason": "Fail-closed fallback: at least one changed path is not explicitly allow-listed. Classify new paths in .github/mobile-impact-policy.json in the same pull request."
  }
}

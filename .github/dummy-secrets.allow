sk_test_fakeKeyForTestSuite000000000000

# Stripe webhook signing secret for locally computed signatures.
whsec_fakeWebhookSecretForTests

# Placeholder printed in the example env and docs. Not a Stripe endpoint.
whsec_your_webhook_secret_here


# Copy this file to `.env` in the same directory as docker-compose.yml.
# Docker Compose reads that file automatically. Change a host port here;
# do not edit the port mappings in the YAML.
#
# These names only change the port on your machine (the left-hand side).
# Containers still talk to each other on the fixed container ports
# (frontend 5173, backend 80, database 3306, and so on).
#
# Leave a line unset to keep today's default. Spoken answers stay bound
# to 127.0.0.1; only the host port is configurable.

SYNAPLAN_FRONTEND_PORT=5173
SYNAPLAN_BACKEND_PORT=8000
SYNAPLAN_DB_PORT=3307
SYNAPLAN_OLLAMA_PORT=11435
SYNAPLAN_TIKA_PORT=9999
SYNAPLAN_PHPMYADMIN_PORT=8082
SYNAPLAN_MAILHOG_SMTP_PORT=1025
SYNAPLAN_MAILHOG_UI_PORT=8025
SYNAPLAN_KEYCLOAK_HTTP_PORT=8080
SYNAPLAN_KEYCLOAK_HTTPS_PORT=8443
SYNAPLAN_QDRANT_PORT=6333
SYNAPLAN_TTS_PORT=10200

# Environment files (auto-generated or local overrides)
.env
.env.bak.*
.env.docker
.env.local
.env.*.local
.cursorignore

.fixtures_loaded

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
.cursor/

# OS
.DS_Store
Thumbs.db
.DS_Store?
._*

# Docker volumes and data
volumes/
/data/
/deploy/data/
/deploy/.lifecycle/
# But allow frontend source data
!frontend/src/data/

# Logs
*.log
logs/

# Backend cache & build
backend/var/cache/
backend/var/log/
backend/.phpunit.cache/
backend/vendor/

# Frontend cache & build
node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/dist-widget/*
!frontend/dist-widget/.gitkeep
frontend/.vite/
*.tsbuildinfo

# Test artifacts
*.cache
frontend/tests/e2e/tests/test-results/
frontend/tests/e2e/tests/reports/

# Editor artifacts
*.code-workspace

# Platform configs
platform/
_devextras/agents_yusuf.md
_devextras/agents_furkan.md

# README tour: only the generated WebP is committed, not the raw captures
docs/images/tour/src/

# Screenvideo outputs
_devextras/screenvideo/videos/*
!_devextras/screenvideo/videos/.gitkeep
_devextras/screenvideo/node_modules/
_devextras/screenvideo/test-results/
_devextras/screenvideo/playwright-report/
_devextras/screenvideo/.narration-tmp/

# Plugins (developed externally, copied to server manually)
plugins/brogent/
plugins/synaform/
plugins/synasort/
plugins/synaads/
plugins/synafastbill/
plugins/synamail/

#local development stuff
_devextras/local-ignore/

# Local output of scripts/mobile-impact.mjs. Anchored to the repo root on
# purpose: every workflow passes an explicit --output elsewhere
# (mobile-impact/manifest.json, mobile-release/mobile-release-manifest.json),
# and those must stay visible to git. Only a run without --output lands here.
/mobile-release-manifest.json
/mobile-impact-manifest.json
